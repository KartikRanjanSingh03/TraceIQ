# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is listed in .gitignore.
# Variable names match docs/16_DEPLOYMENT_AND_TELEMETRY.md §3 exactly.

# ── Database ──────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults (change user/password for production)
DATABASE_URL=postgresql://traceiq_user:changeme@localhost:5432/traceiq

# ── LLM provider ─────────────────────────────────────────────────────────────
# Options: "gemini" | "claude" | "mock"  (see docs/09_LLM_ARCHITECTURE.md §8)
LLM_PROVIDER=gemini

# ── API keys (fill in exactly ONE of the following) ──────────────────────────
# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (used when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── JWT / API security (docs/11_SECURITY_AND_API.md §2) ──────────────────────
# Use a long random string in production — never use this placeholder
JWT_SECRET=change_this_to_a_long_random_secret_before_use
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
